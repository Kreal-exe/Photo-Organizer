<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PhotoOrganizer</AssemblyName>
    <RootNamespace>PhotoOrganizer</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Photo Organizer</Product>
    <Copyright>MIT License</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.*" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The English interface is the macOS app's own translation table. -->
    <EmbeddedResource Include="..\..\Resources\en.lproj\Localizable.strings" LogicalName="Localizable.strings" />
    <!-- MobileCLIP vectors of the labels photos are tagged with (Tools/make_clip_labels.py). -->
    <EmbeddedResource Include="Resources\clip-labels.bin" LogicalName="clip-labels.bin" />
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

</Project>
